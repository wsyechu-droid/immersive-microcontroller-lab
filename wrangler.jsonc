{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "immersive-microcontroller-lab",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
